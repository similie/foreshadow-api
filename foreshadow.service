# sudo nano /etc/systemd/system/foreshadow.service
# sudo systemctl daemon-reload
# sudo systemctl start foreshadow
# sudo systemctl enable foreshadow

[Unit]
Description=Hyphen Foreshadow
After=network.target

[Service]
User=root
WorkingDirectory=/root/foreshadow-api/tile_renderers
ExecStart=/bin/bash -c 'source /root/foreshadow-api/.venv/bin/activate && exec uvicorn main:app --host 0.0.0.0 --port 5001 --workers 2'

Restart=always

StandardOutput=append:/root/foreshadow-api/fastapi.log
StandardError=append:/root/foreshadow-api/fastapi.log

[Install]
WantedBy=multi-user.target
